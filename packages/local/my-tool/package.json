{
  "name": "@deepseek-ai/dsh-my-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "My custom tool for DeepSeek Harness",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
